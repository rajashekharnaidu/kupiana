# Kupiana production environment template
#
# Copy this file to .env on the target server and replace every placeholder.
# Keep .env out of version control and outside public backups.

CI_ENV=production
APP_BASE_URL=https://www.example.com/
APP_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

DB_HOST=localhost
DB_USERNAME=kupiana_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_DATABASE=kupiana
DB_DRIVER=mysqli
DB_PREFIX=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_DSN=

COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
SESSION_SAVE_PATH=application/cache/sessions
TRUSTED_PROXY_IPS=

# ZeptoMail / Zoho transactional email
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Kupiana
MAIL_ENABLED=false

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENABLED=false

# Courier tracking webhook HMAC secret
TRACKING_WEBHOOK_SECRET=
